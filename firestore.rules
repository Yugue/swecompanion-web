rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isPremium() {
      return isSignedIn() &&
        request.auth.token.subscribed == true &&
        exists(/databases/$(database)/documents/billing/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/billing/$(request.auth.uid)).data.subscribed == true;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId) &&
        request.resource.data.keys().hasOnly(['email', 'displayName', 'createdAt']);

      // Legacy fields are preserved but cannot be added or changed by clients.
      allow update: if isOwner(userId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email', 'displayName']);

      match /progress/{kind} {
        allow read, write: if isOwner(userId);
      }
    }

    match /billing/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    // Customer mappings, webhook receipts, and locks are server-only (default deny).
    // Legacy database-backed quiz copies remain restricted to premium accounts.
    // Public ML quizzes are included in their static pages from scripts/quizzes.json
    // and do not read this collection. Client writes remain prohibited.
    match /quizzes/{quizId} {
      allow read: if isPremium();
      allow write: if false;
    }
  }
}
