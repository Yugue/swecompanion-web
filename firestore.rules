rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isPremium() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.premium == true;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);

      // First-time profile creation must start non-premium.
      allow create: if isOwner(userId) && request.resource.data.premium == false;

      // `premium` can never change from a client write - only the Firestore console
      // (or a future billing Cloud Function using the Admin SDK, which bypasses rules) can flip it.
      allow update: if isOwner(userId) &&
        request.resource.data.premium == resource.data.premium;

      match /progress/{kind} {
        allow read, write: if isOwner(userId);
      }
    }

    // Legacy database-backed quiz copies remain restricted to premium accounts.
    // Public ML quizzes are included in their static pages from scripts/quizzes.json
    // and do not read this collection. Client writes remain prohibited.
    match /quizzes/{quizId} {
      allow read: if isPremium();
      allow write: if false;
    }
  }
}
